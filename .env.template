# REQUIRED
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
SECRET_KEY=
EMAIL_TOKEN_SALT=

KAFKA_URL=

SMTP_USER=
SMTP_USER_PASSWORD=


# OPTIONAL: leave empty to use the default
# Defaults: POSTGRES_PORT=5432, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
POSTGRES_PORT=
SMTP_HOST=
SMTP_PORT=

# Base URL used in verification email links. Default: http://127.0.0.1:8000
PUBLIC_BASE_URL=

# Defaults: EMAIL_TOKEN_EXPIRE_HOURS=24, ACCESS_TOKEN_EXPIRE_MINUTES=30, REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_HOURS=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Defaults: ELASTICSEARCH_URL=http://elasticsearch:9200, REDIS_HOST=localhost, REDIS_PORT=6379
ELASTICSEARCH_URL=
REDIS_HOST=
REDIS_PORT=

# Per-IP rate limits. Defaults: RATE_LIMIT_LOGIN_PER_MINUTE=10,
# RATE_LIMIT_REGISTER_PER_HOUR=5, RATE_LIMIT_RESEND_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=
RATE_LIMIT_REGISTER_PER_HOUR=
RATE_LIMIT_RESEND_PER_HOUR=

# Production only (`make up-prod`): the public domain Traefik serves and gets a Let's Encrypt
# certificate for. Its DNS must point to this server, and ports 80 and 443 must be open.
DOMAIN=

# Read by uvicorn, not by the app: the proxy addresses whose X-Forwarded-For header is trusted
# as the client IP. Default 127.0.0.1. Set it to your reverse proxy's address; never to * when
# the API port is reachable without the proxy, or clients can fake their IP.
FORWARDED_ALLOW_IPS=

# Database for tests. Default: SQLite file. A PostgreSQL test database name must end with _test,
# because tests drop all tables, e.g. postgresql+asyncpg://user:password@localhost:5432/blog_test
TEST_DATABASE_URL=

# AI providers. Defaults: CONTENT_VALIDATOR=groq (groq or openai), REPLY_GENERATOR=groq
CONTENT_VALIDATOR=
REPLY_GENERATOR=
# Key for each provider you use
GROQ_API_KEY=
OPENAI_API_KEY=
